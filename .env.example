# ─────────────────────────────────────────────────────────────────────────────
# Nexus backend environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.
#
# Each deployed environment (dev / preprod / prod) is its OWN checkout on the
# VPS with its OWN `.env`. PM2 (ecosystem.config.js) sets NODE_ENV and PORT;
# dotenv does not override already-set vars, so PM2 wins and this file supplies
# the rest.
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this process runs as:  dev | preprod | prod
# Also picks which messaging environment the OTP login should be connected to.
NODE_ENV=dev

# HTTP port. Convention on the VPS: prod=6000, dev=6001, preprod=6002.
PORT=6001

# ── Database (self-hosted PostgreSQL 16 / Prisma) ────────────────────────────
# Migrated off Neon on 2026-08-14: three always-on branches burned ~540 CU-hours
# against a 100 CU-hour free allowance, which suspended compute and took the
# platform down. Postgres now runs on the VPS itself.
#
# ONE pair per checkout. Do NOT use DEV_/PREPROD_/PROD_ prefixes: Prisma reads
# these exact names and has no NODE_ENV switching, and the Prisma CLI
# (migrate/generate/studio) reads them too — so a prefixed setup risks the app
# using one database while migrations alter another.
#
# Isolation comes from each environment's own .env, not from variable names.
# One database per environment on a single local cluster:
#   prod -> nexus_prod, preprod -> nexus_preprod, dev -> nexus_dev
#
# Postgres listens on localhost only and is never exposed to the internet, so
# these connections carry no sslmode. There is no pooler, so both URLs are the
# same; DIRECT_URL stays separate because Prisma's advisory locks need a
# non-pooled connection if a pooler is ever added.
#
# REQUIRED — not optional. Prisma does not fall back to DATABASE_URL; if
# DIRECT_URL is missing the schema fails to load entirely (error P1012).
DATABASE_URL="postgresql://nexus:PASSWORD@localhost:5432/nexus_dev"
DIRECT_URL="postgresql://nexus:PASSWORD@localhost:5432/nexus_dev"

# ── Switching databases locally ──────────────────────────────────────────────
# Keep exactly ONE pair active. Whatever is ACTIVE here is what
# `prisma migrate deploy` will alter — this file is the only thing standing
# between a local command and the production database.
#
# Never run `prisma db push`. It applies schema changes without recording a
# migration; doing so on Neon lost four tables from the migration history and
# left the chain unable to rebuild a database. Use `prisma migrate dev`.

# ── Backups ──────────────────────────────────────────────────────────────────
# Neon did point-in-time recovery silently; nothing does that automatically now.
# /home/sanskarpandit/bin/nexus-db-backup.sh dumps all three databases nightly
# at 02:30 to ~/backups/postgres (14-day retention, verified with pg_restore
# --list). Those dumps sit on the same disk as the database, so they cover human
# error but NOT host loss — copy them off the box for that.

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret for signing admin JWTs.
JWT_SECRET=your_long_random_secret

# Admin console sign-in is phone + OTP. Set to "false" to disable the legacy
# email+password route (/auth/login) once every admin has a phone on record.
ALLOW_PASSWORD_LOGIN=true

# ── OTP (Code Implants Messaging) ────────────────────────────────────────────
# Console OTPs go through messaging (msg.codeimplants.com), which holds the one
# copy of the 2Factor key. dev and preprod use messaging dev: it sends nothing
# and every code is 123456. prod uses messaging prod and sends real SMS.
#
# Written by messaging-backend/scripts/connect-app.sh on the server (it mints
# the key and never prints it). Without MESSAGING_API_KEY, OTP login is refused
# rather than falling back to a fixed code; password login is the way in then.
MESSAGING_BASE_URL=
MESSAGING_API_KEY=
# Key used to HMAC the OTP session (phone + sessionId + expiry). No OTP is stored.
# Defaults to a weak literal when unset — set a real value in every environment.
HASH_KEY=your_secure_hash_key

# ── Federation ───────────────────────────────────────────────────────────────
# Encrypts App.backendServiceToken (the per-app credential AppAdminService uses
# to call that app's own backend) at rest. Required — there is no fallback;
# set a real random value in every environment. Rotating it makes previously
# encrypted tokens undecryptable, so treat it like a database credential.
SERVICE_TOKEN_KEY=your_random_encryption_key

# --- CORS ------------------------------------------------------------------
# Extra browser origins allowed to call this API, on top of the built-in list
# in src/main.ts. Adding an app on a new domain is an .env edit and a restart,
# not a code change and three deploys.
#
# The built-in list is never replaced, only extended: a mistyped value here can
# fail to add a domain but can never lock out an app that already works.
#
# Exact origins (scheme + host, comma-separated):
CORS_EXTRA_ORIGINS=
#
# Domain suffixes — matches the apex AND every subdomain, so
# 'barnefarms.com' covers barnefarms.com, dev.barnefarms.com and
# preprod.barnefarms.com in one entry.
#
# Be careful: a suffix is more powerful than it looks. Never put a shared
# hosting domain here (firebaseapp.com, web.app, vercel.app, netlify.app,
# pages.dev, github.io) — that would allow EVERY site hosted there. Use
# CORS_EXTRA_ORIGINS with the exact origin instead. Boot logs a warning if you
# do it anyway, and ignores any suffix without a dot.
CORS_EXTRA_ORIGIN_SUFFIXES=barnefarms.com
