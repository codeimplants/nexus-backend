generator client {
  provider = "prisma-client-js"
}

// NEVER run `prisma db push` against any environment. It writes schema changes
// straight to the database and records nothing in prisma/migrations, so the
// migration history silently stops reproducing the real schema. Four tables
// (Device, AppAnalytics, StoreUrl, MaintenanceMode) and a dozen columns were
// lost that way on Neon; rebuilding from scratch failed until 20260723000000
// and 20260814000000 reconstructed them by hand. Use `prisma migrate dev`.
//
// To check the chain still reproduces the schema (empty output == correct):
//   npx prisma migrate diff --from-schema-datasource prisma/schema.prisma \
//                           --to-schema-datamodel  prisma/schema.prisma --script
datasource db {
  provider  = "postgresql"
  // Self-hosted PostgreSQL 16 on the VPS, reachable on localhost only.
  url       = env("DATABASE_URL")
  // Migrations connection. There is no pooler in front of local Postgres, so
  // this is the SAME endpoint as url — it stays a separate variable because
  // Prisma's advisory locks need a non-pooled connection, and a pooler may be
  // introduced later without touching this file.
  // REQUIRED: there is no fallback. Every .env (local and each VPS checkout)
  // must define DIRECT_URL or the schema fails to load with P1012.
  directUrl = env("DIRECT_URL")
}

model Admin {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  // Phone + OTP is the only console login. `password` is a random unusable
  // hash kept only because the column is required.
  phone            String?           @unique
  name             String?
  role             String            @default("ADMIN") // SUPER_ADMIN | ADMIN | COLLABORATOR | LEAD_GEN
  isActive         Boolean           @default(true)
  // Authenticator (TOTP) for approving changes. Secret is AES-GCM encrypted
  // (service-token-cipher). Set but mfaEnabledAt null = setup not confirmed.
  mfaSecret        String?
  mfaEnabledAt     DateTime?
  // Last 30s step a code was accepted for, so one code cannot be replayed.
  mfaLastStep      Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  appCollaborators AppCollaborator[]
  pushTokens       AdminPushToken[]
  refreshTokens    RefreshToken[]
  ledgerPartner    LedgerPartner?
}

/// A phone running the Nexus admin app, registered for push alerts.
/// Rows go when the admin signs out on that phone or Expo reports the token dead.
model AdminPushToken {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token      String   @unique // ExponentPushToken[...]
  platform   String // ios | android
  deviceName String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([adminId])
}

// Console sessions. The access JWT lives 15 minutes; this opaque token renews it
// so an admin is not asked for an OTP again until they log out or stay idle past
// the refresh TTL. Only a SHA-256 of the token is stored. Each use rotates it; a
// rotated (revoked) token presented again means it leaked, so the whole family
// (one login) is revoked.
model RefreshToken {
  id        String    @id @default(uuid())
  adminId   String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([familyId])
}

model AppCollaborator {
  id        String   @id @default(uuid())
  appId     String
  adminId   String
  createdAt DateTime @default(now())
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([appId, adminId])
  @@index([adminId])
  @@index([appId])
}

model App {
  id                      String            @id @default(uuid())
  name                    String
  appId                   String?
  minVersionIos           String?
  minVersionAndroid       String?
  apiKey                  String            @unique
  description             String?
  platforms               String[]
  icon                    String?
  isActive                Boolean           @default(true)
  // Federation: how the platform reaches this app's own backend for
  // app-specific admin activities + on-demand phone/registration lookup.
  backendBaseUrl          String? // e.g. https://sonebill-backend.example.com
  backendServiceToken     String? // service credential; encrypted at rest, never returned to dashboard
  // Path on the app's backend returning its users (id + phone + registration
  // date), used to resolve pseudonymous ids to real contacts for outreach.
  // e.g. "/api/dukandar/stats"
  backendUsersPath        String?
  // Base path for deleting a user on the app's own backend, invoked as
  // DELETE {backendBaseUrl}{backendDeleteUserPath}/{externalUserId}. The app's
  // own deletion process runs there (cascade + retention of basic details).
  // e.g. "/api/dukandar"
  backendDeleteUserPath   String?
  // Path returning the users this app has ALREADY deleted on its own side, so
  // Nexus can drop their telemetry rows. Positive evidence on purpose: rows are
  // removed only when they appear in this list, never because a profile lookup
  // failed to return them — fetchUserProfiles swallows its own errors, so
  // "absent" and "the backend timed out" are indistinguishable and inferring
  // deletion from absence would empty the table on one bad request.
  // e.g. "/api/dukandar/deleted-log"
  backendDeletedUsersPath String?
  // Phone numbers to hide from Engagement and Leads: internal test handsets, CI
  // devices and staff accounts. They are real users to the app and must keep
  // reporting, but they are not customers and distort every behavioural read --
  // a CI phone was the single heaviest "user" on this app. Matched on the last
  // 10 digits, so +91 and bare forms are the same number.
  excludedPhones          String[]          @default([])
  // GA4 property id for this app's own Firebase Analytics. Read access must be
  // granted to Nexus's shared reporting service account (see
  // GA4_SERVICE_ACCOUNT_KEY_PATH) via Firebase Console > Property Access
  // Management on this property — not a secret itself, so it isn't encrypted.
  ga4PropertyId           String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  rules                   VersionRule[]
  devices                 Device[]
  analytics               AppAnalytics[]
  endUsers                EndUser[]
  usageSessions           UsageSession[]
  dailyUsage              DailyUsage[]
  maintenanceMode         MaintenanceMode?
  storeUrls               StoreUrl[]
  collaborators           AppCollaborator[]
  featureFlags            FeatureFlag[]
}

/// A named switch an app reads at launch, delivered in the /sdk/version/check
/// response so it reaches published binaries with no release.
///
/// Nexus can only turn a feature OFF. The app treats a flag as authoritative only
/// when it is `false`; the product's own config decides whether a feature is on in
/// the first place. One clear rule beats two systems that can both win, where a
/// flag set here and forgotten makes the product's own toggle look broken.
///
/// Keys are owned by each app, not enumerated here, so a new flag needs no
/// migration — an app ignores keys it does not recognise.
model FeatureFlag {
  id          String   @id @default(uuid())
  appId       String
  /// The app's flag key, e.g. "tutorials".
  key         String
  /// Which platform this row applies to: android | ios | web, or "all".
  ///
  /// A plain string defaulting to "all" rather than a nullable column, because
  /// Postgres treats NULLs as distinct in a unique index — nullable would happily
  /// accept two "every platform" rows for the same key and then serve whichever
  /// the query happened to return first.
  platform    String   @default("all")
  isEnabled   Boolean  @default(true)
  /// Why this flag exists, for whoever finds it switched off later.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, key, platform])
  @@index([appId])
}

model VersionRule {
  id          String @id @default(uuid())
  appId       String
  platform    String // android | ios | web | windows | macos | linux
  environment String // prod | staging | dev

  latestVersion   String // Latest available version
  updateType      String // soft | force | none
  blockedVersions String[] // Specific versions to block
  killSwitch      Boolean  @default(false)
  isActive        Boolean  @default(true)
  priority        Int      @default(0) // Higher priority rules are evaluated first

  /// Apply this rule to installs that report NO version at all.
  ///
  /// Off by default and only meaningful with updateType "force". Turning it on
  /// asserts that every build capable of reporting a version is at or above
  /// latestVersion — otherwise the clients it catches can never satisfy it. See
  /// VersionEngine.evaluate() for the full argument.
  forceUnversionedClients Boolean @default(false)

  // Message Configuration
  messageConfig Json // { title, message, buttonText, etc. }

  // Advanced Features
  rolloutPercentage Float     @default(100) // Gradual rollout (0-100)
  startDate         DateTime?
  endDate           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, platform, environment])
  @@index([isActive])
}

model StoreUrl {
  id        String   @id @default(uuid())
  appId     String
  platform  String // android | ios | web
  storeUrl  String // Play Store, App Store, or Web URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, platform])
}

model MaintenanceMode {
  id           String    @id @default(uuid())
  appId        String    @unique
  isEnabled    Boolean   @default(false)
  title        String    @default("Under Maintenance")
  message      String    @default("We are currently performing maintenance. Please check back soon.")
  estimatedEnd DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)
}

model Device {
  id           String   @id @default(uuid())
  appId        String
  deviceId     String // Unique device identifier
  platform     String
  osVersion    String?
  appVersion   String?
  buildNumber  String?
  // Device make/model promoted from metadata to first-class columns so the
  // dashboard can break users down by manufacturer/model (iPhone vs Android make/model).
  make         String? // e.g. Apple, Samsung, Xiaomi
  model        String? // e.g. iPhone15,2 / SM-G991B
  manufacturer String? // raw manufacturer string when distinct from make
  lastCheckIn  DateTime @default(now())
  firstSeen    DateTime @default(now())
  isActive     Boolean  @default(true)
  metadata     Json? // Additional device info (still populated for backward-compat)

  // Link to the logged-in end user on this device (nullable: installed-but-not-logged-in).
  endUserId String?

  app     App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  endUser EndUser? @relation(fields: [endUserId], references: [id], onDelete: SetNull)

  @@unique([appId, deviceId])
  @@index([appId, platform])
  @@index([lastCheckIn])
  @@index([endUserId])
}

// A logged-in end user of a client app. Pseudonymous: we store only the app
// backend's own user id (externalUserId), never credentials or raw PII. Phone and
// registrationDate are federated on-demand from the app's own backend.
model EndUser {
  id             String   @id @default(uuid())
  appId          String
  externalUserId String // the app-backend user _id
  platform       String? // platform of first identify
  authMethod     String? // otp | email | ... (reporting only, expandable)
  registeredAt   DateTime @default(now()) // first time we saw this user identify
  firstSeen      DateTime @default(now())
  lastActiveAt   DateTime @default(now())

  app           App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  devices       Device[]
  usageSessions UsageSession[]
  dailyUsage    DailyUsage[]

  @@unique([appId, externalUserId])
  @@index([appId, lastActiveAt])
}

// A single foreground session, opened on APP_OPEN and closed on APP_BACKGROUND.
model UsageSession {
  id          String    @id @default(uuid())
  appId       String
  endUserId   String? // null when the session happens before login
  deviceId    String
  platform    String?
  appVersion  String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int? // computed on close

  app     App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  endUser EndUser? @relation(fields: [endUserId], references: [id], onDelete: SetNull)

  @@index([appId, deviceId, endedAt])
  @@index([appId, startedAt])
  @@index([endUserId])
}

// Per-user per-day rollup for fast day/week/month/year aggregation.
model DailyUsage {
  id               String   @id @default(uuid())
  appId            String
  endUserId        String
  date             DateTime @db.Date // date-only (UTC day bucket)
  totalDurationSec Int      @default(0)
  openCount        Int      @default(0)
  sessionCount     Int      @default(0)

  app     App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  endUser EndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@unique([appId, endUserId, date])
  @@index([appId, date])
}

model AppAnalytics {
  id          String   @id @default(uuid())
  appId       String
  date        DateTime @default(now())
  platform    String
  environment String
  version     String?
  eventType   String // version_check | update_soft | update_force | kill_switch | blocked
  deviceId    String?
  metadata    Json?

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, date])
  @@index([appId, eventType])
  @@index([platform, version])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  adminEmail String?
  // Append-only: nothing in the API updates or deletes these rows.
  action     String // CREATE | UPDATE | DELETE | LOGIN | etc.
  entity     String // App | VersionRule | MaintenanceMode | etc.
  entityId   String?
  payload    Json
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entity, action])
  @@index([createdAt])
}

/// One platform-hardening item: an infrastructure gap we know about, the risk it
/// carries once we have paying users, and a copy-ready brief a teammate can paste
/// straight into their own AI session to start the work.
///
/// Why this lives in Nexus rather than a markdown file in a repo: the team opens
/// Nexus already, the list has to be edited without a deploy, and two people must
/// not silently start the same item. `owner` and `status` are the whole point —
/// a register nobody can claim an item on is just a document.
///
/// Rows are reference data seeded by migration 20261115000000 from the
/// 2026-11-15 infrastructure audit, then maintained through the UI. Severity and
/// status are plain strings with the allowed values listed below rather than
/// Postgres enums, matching Admin.role and FeatureFlag.platform elsewhere in this
/// schema: adding a value must not need a migration.
model HardeningItem {
  id          String    @id @default(uuid())
  /// Stable slug, e.g. "external-uptime-monitoring". Unique so the seed migration
  /// can be re-run, and so an item can be referred to in chat or a commit message
  /// without quoting a uuid.
  key         String    @unique
  title       String
  /// CRITICAL | HIGH | MEDIUM | LOW
  severity    String    @default("MEDIUM")
  /// OPEN | IN_PROGRESS | BLOCKED | DONE
  status      String    @default("OPEN")
  /// INFRA | SECURITY | DATA | CI_CD | OBSERVABILITY | COMPLIANCE | PROCESS
  category    String
  /// What is missing or wrong today.
  gap         String
  /// What it costs us specifically once real customers are paying.
  risk        String
  /// Pasteable brief for a teammate's own AI session: enough context to start
  /// without re-deriving the audit. This is the field the Copy button yields.
  aiBrief     String
  /// Which apps, repos or hosts this touches.
  scope       String?
  /// Who has claimed it. Free text, not a relation to Admin: some items are
  /// carried by people who have no Nexus login, and an unassignable item should
  /// still be nameable.
  owner       String?
  /// What was actually observed when the item was raised, so nobody has to go
  /// looking again to believe it.
  evidence    String?
  /// Lower sorts first. Ties fall back to severity then title.
  sortOrder   Int       @default(100)
  /// Progress notes, newest appended. Deliberately one free-text column rather
  /// than a comment table: this is a register, not a ticketing system, and the
  /// moment it needs threads it should become one.
  notes       String?
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, severity])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Ledger: the partners' own books. Which clients we bill and what they still
// owe, which subscriptions we buy and when they renew, who paid or received
// each rupee and by what means, and therefore who owes whom among us.
//
// Conventions for every Ledger model:
//   - Money is integer PAISE (`...Paise`), never a float, so a three-way split
//     of an odd amount cannot leave a stray fraction behind.
//   - Dates are calendar days in IST, stored as DATE (`@db.Date`), because a
//     due date or a payment day has no time of day.
//   - `mode` is UPI | CASH | CARD | BANK | OTHER, a plain string like Admin.role,
//     so adding a value is a DTO change and not a migration.
//   - Shares are WEIGHTS ({ "<partnerId>": weight }), not percentages: 1/1/1 is
//     an exact third each, and 40/30/30 works the same way later.
// ---------------------------------------------------------------------------

/// One of the people who share the costs and the income. Linked to a Nexus
/// account so reminders reach their phone and the page can say "you".
/// Never deleted, only deactivated: their past payments must stay attributable.
model LedgerPartner {
  id        String   @id @default(uuid())
  name      String   @unique
  adminId   String?  @unique
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receiptsReceived  LedgerReceipt[]
  expensesPaid      LedgerExpense[]
  settlementsSent   LedgerSettlement[]   @relation("LedgerSettlementFrom")
  settlementsGot    LedgerSettlement[]   @relation("LedgerSettlementTo")
  subscriptionsPaid LedgerSubscription[]
}

/// How costs and income are split, from a date onward. A transaction uses the
/// schedule in force on its own date, so changing the split later does not
/// rewrite history. Expenses and receipts can each override it.
model LedgerShareSchedule {
  id            String   @id @default(uuid())
  effectiveFrom DateTime @unique @db.Date
  /// { "<partnerId>": weight }
  weights       Json
  note          String?
  createdBy     String?
  createdAt     DateTime @default(now())
}

/// Someone who pays us.
model LedgerClient {
  id          String   @id @default(uuid())
  name        String   @unique
  contactName String?
  phone       String?
  email       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans         LedgerPlan[]
  charges       LedgerCharge[]
  receipts      LedgerReceipt[]
  subscriptions LedgerSubscription[]
  expenses      LedgerExpense[]
}

/// What a client is billed for, once or on repeat. Produces LedgerCharge rows
/// as each due date arrives.
model LedgerPlan {
  id            String       @id @default(uuid())
  clientId      String
  client        LedgerClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  product       String
  amountPaise   Int
  /// 0 = one-time, 1 = monthly, 3 = quarterly, 12 = yearly; any whole number of months.
  cycleMonths   Int
  startDate     DateTime     @db.Date
  /// Last day it may bill on. Null = until stopped.
  endDate       DateTime?    @db.Date
  /// Charges produced so far. The next falls on startDate + cycleMonths x
  /// periodsBilled, counted from the start so a plan on the 31st does not
  /// drift to the 28th after February.
  periodsBilled Int          @default(0)
  /// Derived from the fields above, stored so upcoming dues sort in SQL.
  /// Null once the plan has nothing left to bill.
  nextDueDate   DateTime?    @db.Date
  isActive      Boolean      @default(true)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  charges LedgerCharge[]

  @@index([clientId])
  @@index([isActive, nextDueDate])
}

/// One amount a client owes: produced by a plan, by renewing a subscription
/// we bill on to them, by hardware we sell them, or added by hand.
model LedgerCharge {
  id             String              @id @default(uuid())
  clientId       String
  client         LedgerClient        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  planId         String?
  plan           LedgerPlan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   LedgerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// The purchase this passes on to the client, when it does.
  expenseId      String?             @unique
  expense        LedgerExpense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  description    String
  amountPaise    Int
  dueDate        DateTime            @db.Date
  note           String?
  createdBy      String?
  createdAt      DateTime            @default(now())

  /// A plan bills a given day once, however many times billing runs.
  @@unique([planId, dueDate])
  @@index([clientId, dueDate])
}

/// Money a client paid us, and which partner is holding it.
model LedgerReceipt {
  id           String        @id @default(uuid())
  clientId     String
  client       LedgerClient  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  amountPaise  Int
  receivedOn   DateTime      @db.Date
  mode         String
  receivedById String
  receivedBy   LedgerPartner @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  reference    String?
  note         String?
  /// Overrides the share schedule for this receipt only.
  weights      Json?
  createdBy    String?
  createdAt    DateTime      @default(now())

  @@index([clientId, receivedOn])
  @@index([receivedById])
}

/// Something we pay for again and again: a server, a tool, a domain, a store
/// account, the CA's annual fee, a government filing or challan.
model LedgerSubscription {
  id             String         @id @default(uuid())
  name           String
  /// HOSTING | SOFTWARE | DOMAIN | APP_STORE | EQUIPMENT | PROFESSIONAL |
  /// GOVERNMENT | OTHER, the same list as LedgerExpense.category, which a
  /// renewal copies.
  category       String         @default("OTHER")
  vendor         String?
  /// Null = not known yet (a challan whose amount is set each year).
  amountPaise    Int?
  /// The amount (or the date) is a best guess, e.g. a filing the CA has not
  /// confirmed. Shown as "about" and flagged until someone confirms it.
  isEstimate     Boolean        @default(false)
  /// 1 = monthly, 12 = yearly, 24 = a two-year plan; any whole number of months.
  cycleMonths    Int
  /// Null = not known yet. The page lists these so the gap gets filled.
  nextRenewal    DateTime?      @db.Date
  autoRenew      Boolean        @default(false)
  /// Which card or account it is charged to, as a label ("Swapnil HDFC
  /// card"). Never a card number.
  paymentMethod  String?
  defaultPayerId String?
  defaultPayer   LedgerPartner? @relation(fields: [defaultPayerId], references: [id], onDelete: SetNull)
  /// Set when we bill this on to a client: renewing adds a charge to them.
  clientId       String?
  client         LedgerClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// What the client is charged on renewal. Null = the same as amountPaise.
  rebillPaise    Int?
  isActive       Boolean        @default(true)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  expenses LedgerExpense[]
  charges  LedgerCharge[]

  @@index([isActive, nextRenewal])
}

/// Money we spent, and which partner paid it.
model LedgerExpense {
  id             String              @id @default(uuid())
  description    String
  /// HOSTING | SOFTWARE | DOMAIN | APP_STORE | EQUIPMENT | PROFESSIONAL |
  /// GOVERNMENT | OTHER. EQUIPMENT is hardware we buy to build or run our
  /// software (test phones, printers, devices), whether we keep it or pass it
  /// on to a client; PROFESSIONAL is the CA and similar; GOVERNMENT is ROC
  /// fees, tax and other challans.
  category       String              @default("OTHER")
  vendor         String?
  amountPaise    Int
  paidOn         DateTime            @db.Date
  paidById       String
  paidBy         LedgerPartner       @relation(fields: [paidById], references: [id], onDelete: Restrict)
  mode           String
  subscriptionId String?
  subscription   LedgerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// The client this was bought for, if any. Informational on its own: the
  /// client owes us for it only if a charge links back (`rebill`), so a cost we
  /// absorb is never mistaken for one we pass on.
  clientId       String?
  client         LedgerClient?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Overrides the share schedule for this expense only.
  weights        Json?
  note           String?
  createdBy      String?
  createdAt      DateTime            @default(now())

  rebill LedgerCharge?

  @@index([paidOn])
  @@index([paidById])
  @@index([category])
}

/// One partner paying another to even out who has put in what.
model LedgerSettlement {
  id          String        @id @default(uuid())
  fromId      String
  from        LedgerPartner @relation("LedgerSettlementFrom", fields: [fromId], references: [id], onDelete: Restrict)
  toId        String
  to          LedgerPartner @relation("LedgerSettlementTo", fields: [toId], references: [id], onDelete: Restrict)
  amountPaise Int
  paidOn      DateTime      @db.Date
  mode        String
  note        String?
  createdBy   String?
  createdAt   DateTime      @default(now())

  @@index([paidOn])
}
